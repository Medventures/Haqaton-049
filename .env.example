# Раздел 2 SPEC.md. Копируй в .env и заполняй, значения ниже пустые/дефолтные.

# БД (раздел 2): SQLite локально, Supabase Postgres на деплое.
DATABASE_URL=sqlite:///./aqylroute.db

# Авторизация (раздел 13): JWT в httpOnly cookie.
JWT_SECRET=

# LLM-модуль (раздел 12). Пустой OPENAI_API_KEY переключает модуль в режим заглушки.
OPENAI_API_KEY=
OPENAI_MODEL=

# Email (раздел 2). MAIL_MODE=console пишет письма в таблицу outbox вместо отправки.
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Демо (разделы 13, 16, 19.5). Только при DEMO_MODE=true доступны /demo/*, /dev/mail.
DEMO_MODE=false
DEMO_PASSWORD=

# Web -> API rewrite (раздел 13).
API_URL=http://localhost:8000
