{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aqylroute.local/schemas/providers.schema.json",
  "title": "AqylRoute providers",
  "type": "array",
  "items": { "$ref": "#/definitions/provider" },
  "definitions": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id", "name_ru", "name_kk", "regions", "address_ru", "address_kk",
        "phone", "booking_methods", "hours_ru", "hours_kk", "needs_review"
      ],
      "properties": {
        "provider_id": { "type": "string", "minLength": 1 },
        "name_ru": { "type": "string", "minLength": 1 },
        "name_kk": { "type": "string", "minLength": 1 },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["karaganda_city", "karaganda_region", "other_region"]
          }
        },
        "address_ru": { "type": "string", "minLength": 1 },
        "address_kk": { "type": "string", "minLength": 1 },
        "phone": { "type": "string", "minLength": 1 },
        "booking_methods": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "hours_ru": { "type": "string", "minLength": 1 },
        "hours_kk": { "type": "string", "minLength": 1 },
        "source_ids": { "type": "array", "items": { "type": "string" } },
        "needs_review": { "type": "boolean" }
      }
    }
  }
}
