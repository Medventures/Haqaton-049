{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aqylroute.local/schemas/sources.schema.json",
  "title": "AqylRoute sources",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/definitions/source" },
  "definitions": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "title_ru", "url", "confirms_ru", "revision"],
      "properties": {
        "source_id": {
          "type": "string",
          "enum": ["SRC_ADILET_223", "SRC_PRG_33", "SRC_KOPMPK", "SRC_INKARAGANDA"]
        },
        "title_ru": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "confirms_ru": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 }
      }
    }
  }
}
