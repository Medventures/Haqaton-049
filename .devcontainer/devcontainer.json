{
  "name": "hackathon — React 19 + Vite + Tailwind 4 + Claude Code",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Named volumes общие для ВСЕХ проектов из этого шаблона.
  // claude-code-home -> логин Claude Code переживает пересборку и новый проект
  // gh-config        -> логин gh CLI внутри контейнера тоже сохраняется
  // npm-cache        -> npm install быстрый и работает офлайн начиная со 2-го проекта
  "mounts": [
    "source=claude-code-home,target=/home/node/.claude,type=volume",
    "source=gh-config,target=/home/node/.config/gh,type=volume",
    "source=npm-cache,target=/home/node/.npm,type=volume"
  ],

  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Vite dev server",
      "onAutoForward": "openBrowser"
    }
  },

  "postCreateCommand": "bash .devcontainer/postCreate.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "oxc.oxc-vscode"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "remoteUser": "node"
}
